{
  "name": "datawise-site",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "rm -rf .astro node_modules/.astro && node scripts/webp.mjs && astro build && pagefind --site dist",
    "preview": "wrangler dev --port 8788",
    "check": "python3 scripts/check_parity.py"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "^0.4.2",
    "@astrojs/rss": "^4.0.19",
    "astro": "^7.3.4",
    "image-size": "^2.0.4"
  },
  "devDependencies": {
    "pagefind": "^1.5.2",
    "sharp": "^0.35.4",
    "wrangler": "^4"
  },
  "allowScripts": {
    "esbuild": true
  }
}
