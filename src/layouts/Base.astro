---
import '../styles/global.css';
import { AUTHOR, NAV, SITE } from '../consts';

interface Props {
  title: string;
  description: string;
  /** Absolute URL; defaults to this page. */
  canonical?: string;
  image?: string;
  type?: 'website' | 'article';
  jsonLd?: object[];
  noindex?: boolean;
  alternateMarkdown?: string;
}

const { title, description, canonical, image, type = 'website', jsonLd = [], noindex, alternateMarkdown } = Astro.props;
const selfUrl = new URL(Astro.url.pathname.replace(/\.html$/, '').replace(/\/index$/, '/'), SITE.url).href;
const canonicalUrl = canonical ?? selfUrl;
const ogImage = new URL(image ?? SITE.logo, SITE.url).href;
const current = Astro.url.pathname.replace(/\.html$/, '');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="alternate" type="application/rss+xml" title={SITE.title} href="/rss.xml" />
    {alternateMarkdown && <link rel="alternate" type="text/markdown" href={alternateMarkdown} />}
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#111418" media="(prefers-color-scheme: dark)" />

    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={selfUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <slot name="head" />
    {jsonLd.map((data) => <script is:inline type="application/ld+json" set:html={JSON.stringify(data)} />)}

    <script is:inline>
      // Apply the saved theme before first paint to avoid a flash.
      try {
        const saved = localStorage.getItem('theme');
        if (saved === 'light' || saved === 'dark') document.documentElement.dataset.theme = saved;
      } catch {}
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="wrap header-inner">
        <a class="brand" href="/" aria-label={`${SITE.name} home`}>
          <img src="/icon-64.png" alt="" width="32" height="32" />
          <span>{SITE.name}</span>
        </a>
        <nav aria-label="Main">
          <ul>
            {NAV.map((item) => (
              <li><a href={item.href} aria-current={current === item.href ? 'page' : undefined}>{item.label}</a></li>
            ))}
          </ul>
        </nav>
        <div class="header-actions">
          <a class="icon-button" href="/search" aria-label="Search">
            <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="2"/><path d="m20 20-4-4" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
          </a>
          <button class="icon-button" type="button" id="theme-toggle" aria-label="Toggle dark mode">
            <svg class="sun" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="2"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
            <svg class="moon" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/></svg>
          </button>
        </div>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap footer-inner">
        <p>
          Written by <a href={AUTHOR.url}>{AUTHOR.name}</a>. Get new posts by email from{' '}
          <a href="/newsletter">{SITE.newsletter.name}</a>.
        </p>
        <p class="footer-links">
          <a href="/rss.xml">RSS</a>
          {Object.entries(AUTHOR.links).map(([label, href]) => <a href={href} rel="me">{label}</a>)}
          <a href="/archive">All posts</a>
        </p>
      </div>
    </footer>

    <script is:inline>
      document.getElementById('theme-toggle').addEventListener('click', () => {
        const root = document.documentElement;
        const dark = root.dataset.theme
          ? root.dataset.theme === 'dark'
          : matchMedia('(prefers-color-scheme: dark)').matches;
        root.dataset.theme = dark ? 'light' : 'dark';
        try { localStorage.setItem('theme', root.dataset.theme); } catch {}
      });
    </script>
  </body>
</html>
